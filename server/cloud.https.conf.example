server {
    listen 80;
    listen [::]:80;
    server_name cloud.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/cloud.example.com;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cloud.example.com;

    ssl_certificate /etc/letsencrypt/live/cloud.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cloud.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RKCloudSSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    access_log /www/wwwlogs/cloud.example.com.log;
    error_log /www/wwwlogs/cloud.example.com.error.log;

    proxy_intercept_errors on;
    error_page 502 503 504 =503 /cloud-unavailable.html;

    location = /cloud-unavailable.html {
        root /www/wwwroot/cloud.example.com;
        internal;
    }

    location = / {
        return 302 /explorer/;
    }

    location = /explorer {
        return 302 /explorer/;
    }

    location = /files {
        return 302 /explorer/;
    }

    location ^~ /files/ {
        return 302 /explorer/;
    }

    # The static shell can live on the public server. File data and every API
    # operation still pass through FRP to the RK and remain Key-protected there.
    location ^~ /explorer/ {
        root /www/wwwroot/cloud.example.com;
        index index.html;
        try_files $uri $uri/index.html =404;

        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    }

    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 0;
    }
}
