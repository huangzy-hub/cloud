[global]
    interfaces = lo
    bind interfaces only = yes
    smb ports = 445
    map to guest = never

[RKSSD]
    path = /srv/cloud/SSD
    browseable = yes
    read only = no
    valid users = cloud
    force user = cloud
    create mask = 0660
    force create mode = 0660
    directory mask = 0770
    force directory mode = 0770

[RKUSB]
    path = /srv/cloud/USB
    browseable = yes
    read only = no
    valid users = cloud
    force user = cloud
    create mask = 0660
    force create mode = 0660
    directory mask = 0770
    force directory mode = 0770

[RKUSB2]
    path = /srv/cloud/USB2
    browseable = yes
    read only = no
    valid users = cloud
    force user = cloud
    create mask = 0660
    force create mode = 0660
    directory mask = 0770
    force directory mode = 0770
