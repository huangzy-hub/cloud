[Unit]
Description=RK Cloud single-Key authentication
After=network.target

[Service]
Type=simple
User=cloud
Group=cloud
UMask=0007
EnvironmentFile=-/etc/rk-cloud/cloud.env
ExecStart=/usr/local/lib/rk-cloud/cloud_auth.py --state-dir /etc/cloud-auth serve --listen 127.0.0.1 --port 18081
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/cloud-auth
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
